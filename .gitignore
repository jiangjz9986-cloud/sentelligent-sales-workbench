# Secrets
.env
**/.env
.env.*
**/.env.*
!**/.env.example

# Dependencies and build outputs
**/node_modules/
**/dist/
**/build/
**/coverage/
.npm-cache/

# Runtime state, databases, and logs
.runtime/
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
*.log
*.pid

# Private keys, certificates, archives, and business media
*.pem
*.key
*.p12
*.pfx
*.ppk
*.crt
*.cer
*.bundle
*.zip
*.tar
*.tar.gz
*.tgz
*.webm
*.ogg
*.m4a
*.wav
*.mp3
*.aac
*.flac
*.shortcut
!integrations/icost-shortcut/icost-dual-write.unsigned.shortcut
!integrations/shortcut/shortcut-bookkeeping.unsigned.shortcut

# Local Codex coordination state
.agents/
.codex/
.codex-tmp/
.worktrees/
tmp/
design-options/
design-references/

# This npm-based monorepo does not use a root pnpm lockfile.
/pnpm-lock.yaml

# Generated project outputs. Keep only the active app, selected references,
# brand assets, and current audit evidence under version control.
outputs/*
!outputs/product-design-prototype/
!outputs/product-design-prototype/**
outputs/product-design-prototype/.env
outputs/product-design-prototype/.env.local
outputs/product-design-prototype/.env.*.local
!outputs/product-design-prototype/.env.example
outputs/product-design-prototype/.npm-cache/
outputs/product-design-prototype/node_modules/
outputs/product-design-prototype/dist/
outputs/product-design-prototype/qa/
!outputs/design-renders/
outputs/design-renders/*
!outputs/design-renders/selected/
!outputs/design-renders/selected/**
!outputs/logo/
!outputs/logo/**
!outputs/qa-audit/
!outputs/qa-audit/**

# OS/editor artifacts
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.tmp
