# Render this template before installation. Replace every @...@ placeholder
# with an absolute path or service account value. Keep the environment file
# outside the release tree and mode 0600; never put a provider secret here.

[Unit]
Description=Sentelligent AI unified platform
After=network-online.target
Wants=network-online.target
ConditionPathExists=@PROJECT_ROOT@/ai-platform/src/cli.js

[Service]
Type=simple
User=@SERVICE_USER@
# The platform keeps its own UID and uses a dedicated group only for the
# protected local API socket.  It must never use the business service group.
Group=@SERVICE_GROUP@
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=/opt/sentelligent-sales-workbench/config/ai-platform.env
Environment=NODE_ENV=production
Environment=AI_PLATFORM_HOST=127.0.0.1
Environment=AI_PLATFORM_PORT=18997
Environment=AI_PLATFORM_TARGET_MODEL=gpt-5.6-luna
Environment=AI_PLATFORM_TARGET_REASONING_EFFORT=max
RuntimeDirectory=sentelligent-ai-platform
RuntimeDirectoryMode=0710
Environment=AI_PLATFORM_SOCKET_PATH=/run/sentelligent-ai-platform/api.sock
ExecStartPre=/usr/bin/test -x @NODE_BIN@
ExecStartPre=/usr/bin/test -f @PROJECT_ROOT@/ai-platform/src/cli.js
ExecStart=@NODE_BIN@ @PROJECT_ROOT@/ai-platform/src/cli.js serve
Environment=AI_PLATFORM_DATABASE=@DATABASE_DIR@/ai-platform.sqlite
Environment=AI_PLATFORM_MEDIA_DIRECTORY=@DATABASE_DIR@/media
Restart=on-failure
RestartSec=5
# CentOS 7 / systemd 219 spelling is intentional.
StartLimitInterval=300
StartLimitBurst=5
TimeoutStartSec=75
TimeoutStopSec=210
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWriteDirectories=@RUNTIME_DIR@ @DATABASE_DIR@
MemoryLimit=768M
CPUQuota=100%
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
# Keep all other service-created files private; cli.js explicitly promotes the
# bound API socket to 0660 after the listener is ready.
UMask=0077

[Install]
WantedBy=multi-user.target
