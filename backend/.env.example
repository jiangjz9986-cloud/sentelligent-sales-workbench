PORT=8787
HOST=127.0.0.1
DATABASE_URL=./data/sales-workbench.sqlite
AI_ANALYSIS_MODE=mock
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_VISION_NAME=deepseek-v4-flash-vision-exp
MODEL_API_KEY=
MODEL_TIMEOUT_MS=30000
# Server ASR stays disabled until its independent provider readiness is green.
ASR_MODE=disabled
ASR_PROVIDER=openai-compatible
ASR_BASE_URL=
ASR_MODEL=
ASR_TIMEOUT_MS=45000
ASR_UPLOAD_MAX_BYTES=8388608
ASR_QUICK_MAX_DURATION_MS=120000
ASR_ASSISTANT_MAX_DURATION_MS=60000
ASR_FFPROBE_COMMAND=/usr/bin/ffprobe
ASR_FFMPEG_COMMAND=/usr/bin/ffmpeg
ASR_TEMP_ROOT=/run/sentelligent-asr
ASR_REUSE_MODEL_CREDENTIAL=false
# Python 3.11+ executable used by the built-in hospital tender collector.
HOSPITAL_TENDER_PYTHON=python3
# Production defaults to enabled; development defaults to disabled unless set.
HOSPITAL_TENDER_AUTO_RUN=false
HOSPITAL_TENDER_INTERVAL_MINUTES=60
HOSPITAL_TENDER_BATCH_SIZE=10
# Global proactive assistant scanner. Production defaults to enabled; keep
# development/test disabled unless a local background run is intentional.
PROACTIVE_ASSISTANT_AUTO_RUN=false
PROACTIVE_ASSISTANT_INTERVAL_MINUTES=5
PROACTIVE_ASSISTANT_BATCH_SIZE=50
PROACTIVE_ASSISTANT_LEASE_MS=120000
PROACTIVE_ASSISTANT_RETRY_BASE_MS=30000
PROACTIVE_ASSISTANT_POLL_MS=30000
# Durable proactive model guardrails. Cache and counters survive restarts.
PROACTIVE_ASSISTANT_MODEL_CACHE_TTL_MS=86400000
PROACTIVE_ASSISTANT_MODEL_OWNER_DAILY_LIMIT=100
PROACTIVE_ASSISTANT_MODEL_GLOBAL_DAILY_LIMIT=1000
PROACTIVE_ASSISTANT_MODEL_BUDGET_TIMEZONE=Asia/Shanghai
PROACTIVE_NOTIFICATION_AUTO_RUN=false
PROACTIVE_NOTIFICATION_POLL_MS=60000
PROACTIVE_NOTIFICATION_QUIET_START=22:00
PROACTIVE_NOTIFICATION_QUIET_END=08:00
PROACTIVE_NOTIFICATION_HOURLY_LIMIT=3
PROACTIVE_NOTIFICATION_DAILY_LIMIT=12
# Optional backend-only PushPlus token for aggregated high-relevance batches.
HOSPITAL_TENDER_PUSHPLUS_TOKEN=
# Canonical base64url encoding of exactly 32 random bytes. Keep outside SQLite/Git.
SETTINGS_ENCRYPTION_KEY=
AMAP_WEB_SERVICE_KEY=
AMAP_TIMEOUT_MS=10000
SOLUTION_WRITES_ENABLED=false
NODE_ENV=development
AUTH_REQUIRED=true
AUTH_ACCOUNT=
# Development compatibility only. Keep empty outside development.
AUTH_PASSWORD=
# Generate with: npm run auth:hash
AUTH_PASSWORD_HASH=
# Canonical base64url encoding of at least 32 random bytes.
AUTH_SESSION_SECRET=
AUTH_COOKIE_NAME=sentelligent_session
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5184,http://localhost:5184
JSON_BODY_LIMIT_BYTES=1048576
WEIXIN_AGENT_API_TOKEN=
HOSPITAL_TENDER_SYNC_TOKEN=
HOSPITAL_TENDER_SYNC_OWNER=
ASSISTANT_CONFIRMATION_SECRET=
WEIXIN_AGENT_BACKEND_URL=http://127.0.0.1:8787
WEIXIN_AGENT_OWNER=
WEIXIN_AGENT_SESSION_HOME=
# When enabled, WeChat image/text bookkeeping stays review_required until the
# bound direct-message sender confirms it through the WeChat worker.
WEIXIN_BOOKKEEPING_CONFIRMATION_ENABLED=false
WEIXIN_BOOKKEEPING_OWNER=
WEIXIN_BOOKKEEPING_SENDER_ID=
WEIXIN_OUTBOX_POLL_MS=5000
# Comma-separated sender IDs accepted by the persistent assistant event API.
# Empty means the worker is unbound and every inbound sender is rejected.
WEIXIN_ALLOWED_SENDER_IDS=
# Groups remain denied unless explicitly enabled and optionally allowlisted.
WEIXIN_ALLOW_GROUPS=false
WEIXIN_ALLOWED_GROUP_IDS=
# iOS Shortcut/iCost write variables are retired; historical rows remain
# readable through the migration-compatible repository only.
# Local-only invoice extraction. Leave blank to retain files for manual review.
INVOICE_OCR_COMMAND=
INVOICE_PDF_TEXT_COMMAND=
INVOICE_PDF_IMAGE_COMMAND=pdftoppm
INVOICE_OCR_LANGUAGES=chi_sim+eng
INVOICE_TEXT_EXTRACTION_TIMEOUT_MS=30000
# 发票缺口 3/7/14 天微信升级提醒；首次上线保持关闭，完成历史缺口盘点后再显式开启。
INVOICE_ESCALATION_AUTO_RUN=false
INVOICE_ESCALATION_POLL_MS=60000
