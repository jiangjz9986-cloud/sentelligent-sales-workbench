+  ];
+  const savedEnvironment = new Map(
+    environmentKeys.map((key) => [key, process.env[key]]),
+  );
+  for (const key of environmentKeys) delete process.env[key];
+  try {
+    const db = oldDbModule.openDatabase({ databaseUrl });
